{
  "name": "cv",
  "description": "Curriculum Vitae - Kawai Wong",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node src/build.js",
    "watch": "chokidar \"src/**/*\" -c \"npm run build\"",
    "prestart": "npm run build",
    "start": "concurrently \"npm run watch\" \"browser-sync start --server dist --files 'dist/**/*'\"",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fancycoconut/cv.git"
  },
  "keywords": [
    "cv",
    "resume"
  ],
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^10.0.0",
    "dayjs": "^1.11.21",
    "fs-extra": "^11.3.5",
    "gh-pages": "^6.0.0",
    "handlebars": "^4.7.9",
    "marked": "^15.0.12",
    "puppeteer": "^25.1.0",
    "speakingurl": "^14.0.1"
  }
}
